{
  "name": "EDP-Serialisation",
  "description": "Deterministic allocation-free schema-driven serialisation for the ESPressio Development Platform",
  "keywords": "espressio,serialisation,serialization,json,cbor,embedded,deterministic,esp32",
  "homepage": "https://espressio.org",
  "authors": {
    "name": "Simon Stuart",
    "maintainer": true,
    "url": "https://espressio.org"
  },
  "build": {
    "flags": [
      "-std=gnu++20"
    ],
    "unflags": [
      "-std=gnu++11",
      "-std=gnu++14",
      "-std=gnu++17"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ESPressio-Development-Platform/EDP-Serialisation.git"
  },
  "version": "0.1.0",
  "license": "Apache-2.0",
  "frameworks": "*",
  "platforms": "*",
  "dependencies": [
    {
      "name": "EDP-System",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-System.git#main",
      "platforms": "*"
    },
    {
      "name": "EDP-BoundedTypes",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-BoundedTypes.git#main",
      "platforms": "*"
    },
    {
      "name": "EDP-Memory",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Memory.git#main",
      "platforms": "*"
    },
    {
      "name": "EDP-Platform-Portable",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Platform-Portable.git#main",
      "platforms": "*"
    },
    {
      "name": "EDP-Localisation",
      "version": "https://github.com/ESPressio-Development-Platform/EDP-Localisation.git#main",
      "platforms": "*"
    }
  ]
}
